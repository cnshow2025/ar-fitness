{
  "name": "ar-fitness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AR 動作教練：手機相機姿勢偵測運動 App（PWA）",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
